{
  "name": "conclave",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Native macOS app where several AI models debate a question in rounds and a judge writes the verdict. Local-first.",
  "homepage": "https://github.com/peppolone/conclave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peppolone/conclave.git"
  },
  "bugs": {
    "url": "https://github.com/peppolone/conclave/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "check": "node --disable-warning=ExperimentalWarning src/check.ts",
    "typecheck": "tsc --noEmit",
    "app": "zsh scripts/build-app.sh",
    "app:install": "zsh scripts/build-app.sh --install",
    "test:chaos": "node tests/chaos/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
