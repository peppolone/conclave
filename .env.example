# Copia questo file in .env e incolla le tue chiavi (gratuite).
# Le righe vuote disattivano il provider corrispondente.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# https://console.mistral.ai/api-keys (piano "Experiment", gratuito)
MISTRAL_API_KEY=

# Porta del motore locale (solo API su 127.0.0.1; l'app usa una porta casuale)
PORT=4848

# Facoltativi
# https://cloud.cerebras.ai (piano gratuito)
CEREBRAS_API_KEY=
# https://platform.openai.com/api-keys (a pagamento: nessun piano gratuito garantito)
OPENAI_API_KEY=
